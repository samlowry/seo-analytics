    border-radius: 16px;
    box-shadow: 0 2px 10px rgba(0,50,102,0.1);
    overflow: hidden;
    margin: 20px 0;
}
.gp-header {
    background: #003266;
    color: #fff;
    padding: 25px 30px;
}
.gp-header h2 {
    margin: 0;
    font-size: 24px;
    color: #fff;
}
.gp-tabs {
    display: flex;
    background: #f8f9fa;
    border-bottom: 2px solid #dee2e6;
}
.gp-tab {
    flex: 1;
    padding: 18px 15px;
    background: none;
    border: none;
    color: #0a4c99;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    transition: background 0.2s;
}
.gp-tab:hover {
    background: rgba(73,147,227,0.1);
}
.gp-tab.active {
    background: #003266;
    color: #fff;
}
.gp-tab.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 3px;
    background: #fa5800;
}
.gp-panels {
    padding: 30px;
    background: #fff;
}
.gp-panel {
    display: none;
}
.gp-panel.active {
    display: block;
}
.gp-countries {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
}
.gp-country {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: linear-gradient(135deg, #f0f7ff 0%, #e6f2ff 100%);
    border-left: 3px solid #4993e3;
    border-radius: 6px;
    text-decoration: none;
    color: #003266;
    font-size: 14px;
    transition: transform 0.2s, background 0.2s;
}
a.gp-country:hover {
    background: linear-gradient(135deg, #4993e3 0%, #0a4c99 100%);
    color: #fff;
    transform: translateX(3px);
}
.gp-flag {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
}
.gp-flag-empty {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #4993e3;
    color: #fff;
    font-size: 9px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

@media (max-width: 768px) {
    .gp-tabs {
        overflow-x: auto;
    }
    .gp-tab {
        min-width: 100px;
        padding: 15px 10px;
        font-size: 14px;
    }
    .gp-countries {
        grid-template-columns: 1fr;
    }
    .gp-panels {
        padding: 20px;
    }
}</style> <script defer src="data:text/javascript;base64,"></script> <div class="ai-services-block wp-block-ai-services"><div class="ai-services-container" id="ai-services-dynamic-links"></div></div> <script defer src="data:text/javascript;base64,"></script> </div><div class="page--content-right"><div class="sidebar-banner"><div class="sidebar-banner--title">All In Summer</div><div class="sidebar-banner--image"> <noscript><img width="703" height="630" src="https://guidebook.mostbet.com/wp-content/uploads/2026/07/All-In-Summer.webp" class="attachment-full size-full" alt="All In Summer" decoding="async" srcset="https://guidebook.mostbet.com/wp-content/uploads/2026/07/All-In-Summer.webp 703w, https://guidebook.mostbet.com/wp-content/uploads/2026/07/All-In-Summer-300x269.webp 300w" sizes="(max-width: 703px) 100vw, 703px" /></noscript><img width="703" height="630" src='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20703%20630%22%3E%3C/svg%3E' data-src="https://guidebook.mostbet.com/wp-content/uploads/2026/07/All-In-Summer.webp" class="lazyload attachment-full size-full" alt="All In Summer" decoding="async" data-srcset="https://guidebook.mostbet.com/wp-content/uploads/2026/07/All-In-Summer.webp 703w, https://guidebook.mostbet.com/wp-content/uploads/2026/07/All-In-Summer-300x269.webp 300w" data-sizes="(max-width: 703px) 100vw, 703px" /></div><div class="sidebar-banner--info">This summer, anything goes! Spin from sunset to jackpot!</div><div class="sidebar-banner--dates"><div>Started <span class="sdate-start">20.07.2026</span></div><div>Expires <span class="sdate-end">20.08.2026</span></div></div><div class="sidebar-banner--bottom"><div class="sidebar-banner--bottom-title">💰 Prize pool: EUR 40 000 💰</div> <a class="sidebar-banner--link button-orange" href="https://guidebook.mostbet.com/sign-up/" target="_blank">Participate</a></div> <script type="application/ld+json">{
